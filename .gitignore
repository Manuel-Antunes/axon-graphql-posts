# artefato de build: sai do `rover supergraph compose`, não da mão de ninguém
docker/federation/supergraph.graphql
./data/
.poc-logs/
.mvn/wrapper/maven-wrapper.jar
*.log

# IDEs
.idea/
*.iml
.settings/
.project
.classpath

# Do VSCode, DUAS exceções e só elas: `settings.json` e `extensions.json` são configuração do
# PROJETO, não da máquina de ninguém — e sem elas o `.editorconfig` simplesmente não vale aqui (o
# VSCode não o lê sem a extensão, e o `detectIndentation` adivinha a indentação pelo conteúdo do
# arquivo). Versioná-las é o que faz a convenção existir para quem clona; o resto de `.vscode/`
# continua sendo de cada um.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS
.DS_Store

