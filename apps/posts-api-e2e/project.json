{
  "name": "posts-api-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/posts-api-e2e/src",
  "implicitDependencies": [
    "dev.manuelantunes:quarkus-axon-graphql-posts",
    "dev.manuelantunes:axonposts-tagging"
  ],
  "targets": {
    "lint": {
      "options": {
        "forwardAllArgs": false
      },
      "configurations": {
        "fix": {
          "command": "eslint . --fix"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/posts-api-e2e",
        "command": "tsc --noEmit"
      }
    },
    "test:e2e": {
      "dependsOn": ["^docker:build"],
      "inputs": [
        "default",
        "quarkusStack",
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        {
          "env": "E2E_LOGS"
        }
      ],
      "outputs": [
        "{projectRoot}/target/test-results",
        "{projectRoot}/target/logs"
      ]
    }
  }
}
