<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.manuelantunes</groupId>
        <artifactId>quarkus-axon-graphql</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>quarkus-axon-graphql-posts</artifactId>
    <name>quarkus-axon-graphql-posts</name>
    <description>Axon Framework 5 (entidades anotadas, DCB) + SmallRye GraphQL com Mutiny, em Quarkus</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.39.2</quarkus.platform.version>
        <quarkus-axon.version>2.0.0-alpha6</quarkus-axon.version>

        <!-- Axon Framework 5.3.x: entidades anotadas (@EventSourcedEntity/@EntityCreator), command
             handlers como classes (@InjectEntity). Sem a extensão Spring e sem a extensão Reactor: o
             núcleo do Axon 5 tem API de configuração própria (ApplicationConfigurer) e os gateways já
             devolvem CompletableFuture / Publisher, que o Mutiny consome direto. -->
        <axon.version>5.3.1</axon.version>
        <!-- Reactor é `optional` nos módulos do Axon, mas subscriptionQuery usa Sinks por dentro:
             sem esta dependência explícita, a primeira subscription falha com NoClassDefFoundError. -->
        <reactor.version>3.7.10</reactor.version>
        <!-- MapStruct: input GraphQL -> command e entidade -> view, gerados em tempo de compilação -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <assertj.version>3.27.6</assertj.version>

        <compiler-plugin.version>3.14.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.3</surefire-plugin.version>
        <skipITs>true</skipITs>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- O BOM do Quarkus vem PRIMEIRO de propósito: ele é quem fixa Jackson 2, Reactive Streams,
                 SLF4J e companhia para a plataforma inteira. O BOM do Axon entra depois e gerencia só os
                 artefatos org.axonframework — o converter do Axon usa Jackson 3 (tools.jackson), que é
                 coordenada distinta e não disputa versão com o Quarkus. -->
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ==== GraphQL ======================================== -->
        <!-- SmallRye GraphQL code-first: schema a partir das classes, Uni/Multi nativos, DataLoader
             embutido no @Source em lote. De transporte de subscription vem só o WebSocket
             (graphql-transport-ws e graphql-ws); SSE NÃO vem, e é o que interfaces/graphql/sse
             acrescenta. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-graphql</artifactId>
        </dependency>
        <!-- Já vinha transitivo pelo GraphQL; declarado porque agora é compilado contra: a rota de SSE
             é registrada observando o Router do Vert.x, e o handler herda o da extensão de GraphQL. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-vertx-http</artifactId>
        </dependency>

        <!-- ==== Persistência: read model em PostgreSQL ======================================== -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <!-- O schema é versionado em SQL e o Hibernate roda em `validate`: entidade nova sem migration
             não sobe. O módulo do Postgres é obrigatório desde o Flyway 10. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ==== Segurança: resource server do realm do Keycloak ======================================== -->
        <!-- quarkus-oidc lê o issuer, descobre o JWKS e valida assinatura/exp/iss sozinho; as roles de
             realm do Keycloak (realm_access.roles) já viram roles do SecurityIdentity sem conversor. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc</artifactId>
        </dependency>
        <!-- BcryptUtil: a coluna accounts.password_hash existe para as contas CREDENTIAL do modelo de
             account linking. Quem valida a senha de quem entra pelo Keycloak é o Keycloak. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-elytron-security-common</artifactId>
        </dependency>

        <!-- ==== Validação e mapeamento ======================================== -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>

        <!-- ==== Axon Framework 5, pela extensão de Quarkus ======================================== -->
        <!-- Descobre entidades e handlers em BUILD TIME e publica os gateways como beans. Não é oficial
             da AxonIQ nem do Quarkiverse: é de terceiros e está em alpha. A avaliação da troca, com o
             que ela apagou daqui, está no README. A versão é fixada à mão porque a extensão não entra
             no quarkus-bom. -->
        <dependency>
            <groupId>at.meks.quarkiverse.axonframework-extension</groupId>
            <artifactId>quarkus-axon</artifactId>
            <version>${quarkus-axon.version}</version>
        </dependency>
        <!-- A ponte para o JTA do Quarkus. Substituiu um JtaTransactionManager escrito à mão: além do
             mesmo begin-or-join, ele ativa o request context do CDI e implementa
             attachToProcessingLifecycle, que publica o EntityManager/Connection da transação no
             ProcessingContext — o que um event store JPA/JDBC precisa para compartilhar a conexão. -->
        <dependency>
            <groupId>at.meks.quarkiverse.axonframework-extension</groupId>
            <artifactId>quarkus-axon-transaction</artifactId>
            <version>${quarkus-axon.version}</version>
        </dependency>
        <!-- ==== O EVENT STORE, AGORA NO POSTGRES ================================================ -->
        <!-- Sem esta dependência o default da extensão é o event store EM MEMÓRIA, que some no restart.
             Ele bastou enquanto os eventos não atravessavam processo; deixou de bastar quando a saga
             de tagueamento passou a ser CORREOGRAFADA entre dois serviços: um passo intermediário que
             vive só na memória de um dos dois some no restart do outro, e a saga fica pela metade sem
             ninguém saber.

             As tabelas são mapeadas por entidades JPA de DENTRO dos jars do Axon
             (`AggregateEventEntry`, `TokenEntry`), e é por isso que a V2 existe: com
             `schema-management.strategy=validate`, entidade no classpath sem tabela não sobe. -->
        <dependency>
            <groupId>at.meks.quarkiverse.axonframework-extension</groupId>
            <artifactId>quarkus-axon-jpa-eventstore</artifactId>
            <version>${quarkus-axon.version}</version>
        </dependency>
        <!-- O token store. Hoje NENHUM processor deste projeto usa token — todos são subscribing, e
             subscribing lê da publicação, não de uma posição. Ele está aqui porque a posição de leitura
             é a única parte do estado do Axon que o broker NÃO sabe reconstruir: ack de fila dá entrega
             ao menos uma vez, não "recomece do evento N". Sem token store persistente, trocar um
             processor para streaming faria a projeção reprocessar do zero a cada restart, e a linha
             que causaria isso é uma linha de configuração — longe daqui. -->
        <dependency>
            <groupId>at.meks.quarkiverse.axonframework-extension</groupId>
            <artifactId>quarkus-axon-tokenstore-jpa</artifactId>
            <version>${quarkus-axon.version}</version>
        </dependency>
        <!-- O health check dos event processors é da extensão, mas só aparece se houver quem sirva
             /q/health. Uma linha para ganhar a checagem de que a projeção está de pé. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <!-- axon-eventsourcing arrasta modelling -> messaging -> common/conversion. Declarado mesmo
             vindo pela extensão: é o BOM daqui que fixa a versão do Axon, não o dela. -->
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-eventsourcing</artifactId>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <version>${reactor.version}</version>
        </dependency>
        <!-- O suporte a GraalVM native do Axon, como extensão local. Só tem efeito em build
             nativo; em JVM não faz nada. O porquê de ser uma extensão (e não código aqui) está no
             pom.xml da raiz: @BuildStep não pode morar na aplicação. -->
        <dependency>
            <groupId>dev.manuelantunes</groupId>
            <artifactId>axon-native-support</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ==== Event store e token store persistentes ======================================== -->
        <!-- O default da extensao e' o event store EM MEMORIA, que some no restart. Com este modulo o
             stream vai para o Postgres pelo AggregateBasedJpaEventStorageEngine, e um post criado antes
             do restart continua podendo ser reidratado. E' o que separa a POC de algo operavel. -->
        <!-- Onde cada event processor guarda ATE ONDE leu. Sem token store persistente, um processor
             streaming recomeca do zero (ou do fim) a cada partida; com ele, retoma. E' o equivalente
             correto da ideia de "usar o ack para saber o que ja foi processado" — a posicao e' do
             consumidor, nao da fila. -->

        <!-- ==== Mensageria: RabbitMQ pelo SmallRye Reactive Messaging =========================== -->
        <!-- O transporte para fora do servico. NAO e' o event store: o Rabbit distribui, o Postgres
             guarda. Uma fila nao sabe devolver "os eventos do post X", que e' o que a reidratacao pede.
             Aqui ele e' outbox (eventos daqui para outros servicos) e inbox (eventos de fora virando
             commands). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-messaging-rabbitmq</artifactId>
        </dependency>

        <!-- ==== As libs do monólito modular ======================================== -->
        <dependency>
            <groupId>dev.manuelantunes</groupId>
            <artifactId>axonposts-platform</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.manuelantunes</groupId>
            <artifactId>axonposts-users</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.manuelantunes</groupId>
            <artifactId>axonposts-posts</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.manuelantunes</groupId>
            <artifactId>axonposts-axon-channels</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ==== Observabilidade: OpenTelemetry ======================================== -->
        <!-- Traces, logs e métricas pelo protocolo OTLP. Entra aqui porque a aplicação é um subgraph
             atrás de um router: sem trace distribuído, uma latência vista no Apollo Router não tem como
             ser atribuída a este serviço. O quarkus-opentelemetry instrumenta HTTP, JDBC e o contexto
             de segurança sozinho; o que o Axon faz por dentro do command/event bus NÃO é instrumentado
             por ele (a extensão do Axon não publica spans). -->
        <!-- Traces, logs e métricas pelo protocolo OTLP.
             `quarkus-opentelemetry` e NÃO `quarkus-micrometer-opentelemetry`: as métricas do Axon são
             Micrometer, mas o registry que as recebe é construído em `axonposts-platform`
             (`infrastructure/axon/AxonMetrics`) sobre o bean `OpenTelemetry` daqui — um JAR, não uma
             extensão. Com isso não há `quarkus-micrometer` no build, não há registry de Prometheus
             esperando um coletor que este projeto não sobe, e não há a extensão
             `quarkus-micrometer-opentelemetry`, que está em PREVIEW no Quarkus 3.39. Os dois serviços
             passam a usar exatamente o mesmo mecanismo.
             O quarkus-opentelemetry instrumenta HTTP, JDBC, o conector de mensageria e o contexto de
             segurança sozinho; o que o Axon faz por dentro do command/event bus NÃO é instrumentado em
             SPANS (a extensão não os publica, e o Axon 5 ainda não tem tracing) — é por isso que as
             MÉTRICAS do Axon importam: elas são o único sinal do que acontece ali dentro. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-opentelemetry</artifactId>
        </dependency>
        <!-- Dev Services do stack LGTM (Loki, Grafana, Tempo, Mimir) numa imagem só: em dev o Quarkus
             sobe o container e APONTA o exportador para ele sozinho, sem uma linha de endpoint.
             `provided` de propósito — é ferramenta de desenvolvimento e não vai para o runner de
             produção, exatamente como o Dev Services de Postgres e Keycloak que o projeto já usa. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-observability-devservices-lgtm</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ==== Testes ======================================== -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- AxonTestFixture: given-when-then por command, com repositório em memória -->
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jacoco</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- O realm entra no classpath a partir de docker/, e não de uma cópia: o Dev Services do
                 Keycloak importa exatamente o mesmo arquivo que o docker compose monta. Duas cópias
                 divergiriam, e a divergência só apareceria quando uma delas quebrasse. -->
            <resource>
                <directory>../../docker/keycloak</directory>
                <includes>
                    <include>realm-*.json</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- ==== O SCHEMA COMO SCRIPT DE INICIALIZAÇÃO ========================================= -->
            <!-- Concatena as migrations num único `db/init/schema.sql`, que vai para o classpath e é o
                 que o Dev Services do Postgres executa ao CRIAR o container.

                 POR QUE O SCHEMA PRECISA EXISTIR ANTES DA APLICAÇÃO SUBIR
                 =========================================================
                 Porque `migrate-at-start` perdeu a corrida. `AxonExtension.init` é um recorder de
                 RUNTIME_INIT que resolve o event storage engine e, ao fazê-lo, toca o EntityManager —
                 construindo a persistence unit ANTES de o Flyway ter a vez. Com
                 `schema-management.strategy=validate` contra um banco vazio a aplicação morre com
                 `Schema validation: missing table [accounts]`, e adiar dentro do ComponentBuilder não
                 resolve: a lambda é chamada de dentro do próprio init.

                 Com o event store em memória isso nunca apareceu — o Axon não tocava JPA na partida.

                 A saída é a que vale em produção de qualquer jeito: migrar FORA do processo. Em dev e
                 teste quem faz isso é este script, no `initdb` do container; no compose e em produção é
                 o serviço `flyway`, que roda antes da aplicação. E o gate do `validate` CONTINUA
                 valendo, porque o script é gerado das próprias migrations: entidade que divergir delas
                 ainda derruba a partida.

                 A ordem vem do `<sort>` do Ant, não da ordem que o filesystem devolve — que é
                 arbitrária e faria a V4 rodar antes da V1 em alguma máquina, sem aviso. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${antrun-plugin.version}</version>
                <executions>
                    <execution>
                        <id>db-init-script</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <concat destfile="${project.build.outputDirectory}/db/init/schema.sql"
                                        fixlastline="true">
                                    <sort>
                                        <fileset dir="${project.build.outputDirectory}/db/migration"
                                                 includes="V*.sql"/>
                                    </sort>
                                </concat>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <!-- -parameters: o SmallRye GraphQL casa o nome do argumento do schema com o nome
                         do parâmetro do método quando não há @Name. -->
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!-- AS OPÇÕES DO MAPSTRUCT SÃO DO MÓDULO, e não de uma execução.

                         O processador roda nos DOIS rounds de compilação — principal e testes — e regera
                         os impls em cada um. Presas ao `default-compile`, o round de teste os regerava
                         SEM elas, portanto sem `@ApplicationScoped`, e o que sobrava em `target/`
                         passava a depender de qual round escreveu por último. O build falhava de forma
                         alternada, com erros que não mencionam geração de código:

                           Unsatisfied dependency for type ...PostViewMapper
                           incompatible types: PostViewMapperImpl cannot be converted to PostViewMapper

                         No nível do plugin os dois rounds geram a mesma coisa, e a ordem deixa de
                         importar.

                         `unmappedTargetPolicy=ERROR`: propriedade do destino sem origem é erro de
                         compilação, não aviso — é o que faz um campo novo no command quebrar o build em
                         vez de chegar null do outro lado. -->
                    <compilerArgs>
                        <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                        <arg>-Amapstruct.defaultComponentModel=jakarta-cdi</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          ./mvnw verify -Dnative

          Liga a compilação nativa E o failsafe, que é o que roda os `*IT` CONTRA O BINÁRIO. Sem o
          failsafe o `-Dnative` só produz o executável e não verifica nada — foi o estado deste projeto
          enquanto a validação de native dependia de scripts fora do build.

          Os `*IT` são `@QuarkusIntegrationTest`: caixa-preta, sem CDI. É por isso que eles cobrem menos
          que os `*E2ETest` da JVM — os dois testes que aferem custo (BatchLoading, FederationEntities)
          leem o `Statistics` do Hibernate de dentro do processo e não têm equivalente daqui.
        -->
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>${surefire-plugin.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <systemPropertyVariables>
                                        <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
          ./mvnw verify -Dnative -Pnative-clt-toolchain

          Só para macOS com o Xcode.app quebrado. O `native-image` precisa de clang e ld para linkar;
          quando o Xcode está inconsistente (`dlopen(libxcodebuildLoader.dylib): Symbol not found:
          _XPCTypeBool`) o `xcrun` para de funcionar e o build morre com "Unable to detect supported
          DARWIN native software development toolchain".
          <p>
          A saída é usar as Command Line Tools, e são DUAS coisas: o `PATH` precisa ter
          `/Library/Developer/CommandLineTools/usr/bin` na frente (senão o toolchain nem é detectado), e
          o `-isysroot` precisa ser injetado — o `native-image` NÃO repassa `SDKROOT` nem `DEVELOPER_DIR`
          ao `cc` que ele mesmo invoca, então sem isto falha em `'stdio.h' file not found`.
          <p>
          `MacOSX.sdk` é o symlink do CLT, e não uma versão fixa, de propósito: nesta máquina o SDK 27
          não casa com o `ld` das CLT (`tapi error: unknown architecture arm64e.x1`) e o symlink aponta
          para o par que funciona. NÃO ativar este profile num mac com Xcode sadio.

          PATH=/Library/Developer/CommandLineTools/usr/bin:$PATH           GRAALVM_HOME=<graalvm> JAVA_HOME=<graalvm> ./mvnw verify -Dnative -Pnative-clt-toolchain
        -->
        <profile>
            <id>native-clt-toolchain</id>
            <properties>
                <quarkus.native.container-build>false</quarkus.native.container-build>
                <quarkus.native.additional-build-args>-H:CCompilerOption=-isysroot,-H:CCompilerOption=/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk</quarkus.native.additional-build-args>
            </properties>
        </profile>

        <!--
          ./mvnw verify -Dnative -Pnative-container

          O caminho portátil: compila dentro do builder image do Mandrel, sem toolchain local. Medido
          nesta máquina: NÃO CABE em 7,75 GiB de Docker — morre com exit 137 no `[1/8] Initializing`
          mesmo com -Xmx5g e parallelism=4. Precisa de ~12 GiB para o Docker.
        -->
        <profile>
            <id>native-container</id>
            <properties>
                <quarkus.native.container-build>true</quarkus.native.container-build>
                <quarkus.native.native-image-xmx>10g</quarkus.native.native-image-xmx>
            </properties>
        </profile>

        <!--
          ================================================================================
          AWS LAMBDA: DOIS PERFIS PARA ESTA MESMA APLICAÇÃO, E DUAS FUNÇÕES
          ================================================================================
          Não é redundância: uma função do Lambda tem UM handler, e esta aplicação tem duas portas de
          entrada de naturezas diferentes — HTTP (o GraphQL) e fila (o `posts.PostCreated` que volta de
          quem decidiu a tag). Com o RabbitMQ as duas conviviam no mesmo processo porque o processo era
          longo e escutava as duas coisas ao mesmo tempo. Um Lambda não escuta: ele é CHAMADO, e quem o
          chama é o API Gateway ou o event source mapping, nunca os dois.

          As duas extensões também não convivem: cada uma instala o seu handler, e o
          `quarkus-amazon-lambda` falha o build ao encontrar mais de um `RequestHandler`. Por isso são
          perfis mutuamente exclusivos, e não duas dependências.

          O MESMO artefato de código, empacotado duas vezes:

            ./mvnw package -Plambda-http     -> API Gateway  (query, mutation, schema, _entities)
            ./mvnw package -Plambda-sqs      -> event source mapping da fila de volta

          POR QUE `quarkus.profile` TEM DUAS ENTRADAS
          ==========================================
          `lambda` traz o `application-lambda.properties`; `prod` é o que mantém valendo todas as linhas
          `%prod.` do `application.properties` — datasource, issuer do Keycloak, endpoint do OTLP. Um
          perfil só chamado `lambda` DESLIGARIA as três em silêncio, e a aplicação subiria apontando
          para o Postgres de dev.

          E ISTO PRECISA SER REPETIDO EM RUNTIME: `QUARKUS_PROFILE=lambda,prod` como variável de
          ambiente da função. O que se fixa aqui é a configuração de BUILD TIME; a de runtime é relida
          na partida da função, com o perfil que o ambiente disser — e o default é `prod` sozinho.
          Ver `infra/aws/template.yaml`.
        -->
        <profile>
            <id>lambda-http</id>
            <properties>
                <quarkus.profile>lambda,prod</quarkus.profile>
            </properties>
            <dependencies>
                <!--
                  Traduz o evento do API Gateway para uma requisição do Vert.x e devolve a resposta
                  pronta. Por ser o MESMO roteador do Vert.x, tudo que hoje é servido em /graphql
                  continua sendo: o POST, o SDL em /graphql/schema.graphql, `_service`/`_entities`, o
                  OIDC e a GraphiQL. Não há uma linha de código desta aplicação envolvida.

                  O QUE NÃO ATRAVESSA: a resposta é UM `APIGatewayV2HTTPResponse` montado inteiro em
                  memória — conferido no JAR 3.39.2, que não tem uma referência a
                  `vnd.awslambda.http-integration-response` nem a `RESPONSE_STREAM`. Então a porta de
                  SSE de `interfaces/graphql/sse` e o WebSocket do SmallRye continuam compilados e
                  registrados, e não entregam nada por aqui. Ver `infra/aws/README.md`.
                -->
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-amazon-lambda-http</artifactId>
                </dependency>
                <!-- SnsAddressing/SqsAddressing: o conector novo da SAÍDA. O @AxonOutbox desta
                     aplicação não muda — ele continua dizendo `channel = "post-events-out"` e
                     `namespaces = "posts"`. Quem troca o protocolo é uma linha de .properties. -->
                <dependency>
                    <groupId>dev.manuelantunes</groupId>
                    <artifactId>axonposts-axon-aws</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>

        <profile>
            <id>lambda-sqs</id>
            <properties>
                <quarkus.profile>lambda,prod</quarkus.profile>
            </properties>
            <dependencies>
                <!--
                  O runtime do Lambda "cru": procura o único `RequestHandler` do índice e o liga. Aqui
                  ele acha o `AxonSqsLambda` de `libs/axon-aws` — e `quarkus.lambda.handler=axon-sqs`,
                  no application-lambda.properties, o nomeia explicitamente para que a escolha esteja
                  escrita em vez de depender de haver exatamente um.

                  Esta função continua tendo o GraphQL inteiro no classpath e nunca o serve. É
                  desperdício de tamanho de artefato e de cold start, e é consciente: o alternativo era
                  extrair a camada de aplicação do posts-api para uma lib só para que uma segunda
                  aplicação pudesse importá-la — uma reorganização grande para economizar megabytes num
                  artefato de POC.
                -->
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-amazon-lambda</artifactId>
                </dependency>
                <dependency>
                    <groupId>dev.manuelantunes</groupId>
                    <artifactId>axonposts-axon-aws</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <!-- O handler e a ponte SQSEvent -> canal. Está SÓ aqui, e não no perfil
                     lambda-http, porque o `quarkus-amazon-lambda-http` recusa qualquer
                     `RequestHandler` que ache no índice: "Multiple handler classes. You have a
                     custom handler class and the AWS Lambda HTTP extension." Foi medido. -->
                <dependency>
                    <groupId>dev.manuelantunes</groupId>
                    <artifactId>axonposts-axon-lambda</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>lambda-stream</id>
            <properties>
                <quarkus.profile>lambda,prod</quarkus.profile>
            </properties>
            <!--
              O perfil que NÃO tem extensão de Lambda nenhuma — e é justamente essa a graça.

              A aplicação é empacotada como o que ela é: um servidor HTTP do Quarkus. Quem a
              transforma numa função é o AWS LAMBDA WEB ADAPTER, uma layer oficial da AWS que roda
              como extensão do Lambda, sobe antes do processo, espera o health check e depois traduz
              cada invocação numa requisição HTTP para localhost. Com
              `AWS_LWA_INVOKE_MODE=response_stream` e uma Function URL em `RESPONSE_STREAM`, o que o
              servidor escreve sai para o cliente CONFORME ESCREVE.

              É o que o `quarkus-amazon-lambda-http` não consegue fazer, e não por configuração:
              o `LambdaHttpHandler` dele é um `RequestHandler<APIGatewayV2HTTPEvent,
              APIGatewayV2HTTPResponse>` — o tipo de retorno É a resposta inteira — e o
              `NettyResponseHandler` acumula cada `HttpContent` num `ByteArrayOutputStream`. Mesmo o
              `RequestStreamHandler` do `quarkus-amazon-lambda` não resolveria: o
              `AbstractLambdaPollLoop` entrega ao handler o `OutputStream` da conexão com a Runtime
              API, mas nunca chama `setChunkedStreamingMode` — então o `HttpURLConnection` do JDK
              bufferiza tudo para calcular o `Content-Length`.

              Por isso este perfil não acrescenta dependência alguma: ele só liga os perfis de
              runtime. O `application-lambda.properties` continua valendo inteiro (SNS na saída,
              Cognito na identidade); as linhas `quarkus.lambda.handler` e `axonposts.lambda.sqs.*`
              passam a ser configuração desconhecida, e o Quarkus as ignora com um aviso.

              O empacotamento é o `quarkus-app` normal mais um `run.sh` — quem o monta é o alvo
              `lambda-stream` do Nx, em `apps/posts-api/project.json`.
            -->
            <dependencies>
                <!--
                  A ÚNICA dependência, e ela não tem nada a ver com Lambda: são os conectores que o
                  `application-lambda.properties` nomeia. Sem ela o build falha na hora certa, em
                  build time, com as duas linhas exatas:

                    The channel 'post-events-out'   is configured with an unknown connector (smallrye-sns)
                    The channel 'post-completed-in' is configured with an unknown connector (smallrye-in-memory)

                  O que NÃO entra aqui é o `axonposts-axon-lambda`: o handler de SQS não tem o que
                  fazer num processo que é servidor HTTP, e o canal `post-completed-in` fica com o
                  conector in-memory como objeto nulo — exatamente como na função de API Gateway.
                -->
                <dependency>
                    <groupId>dev.manuelantunes</groupId>
                    <artifactId>axonposts-axon-aws</artifactId>
                    <version>${project.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
