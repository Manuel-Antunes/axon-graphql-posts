{
  "name": "dev.manuelantunes:quarkus-axon-graphql-posts",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": [
        "{projectRoot}/target/surefire-reports",
        "{projectRoot}/target/jacoco-report"
      ],
      "options": {
        "forwardAllArgs": false,
        "command": "./mvnw clean test -pl apps/posts-api -am -Dtest='!*E2ETest,!*IT' -Dsurefire.failIfNoSpecifiedTests=false"
      },
      "dependsOn": ["^publish-local"]
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "outputs": [
        "{projectRoot}/target/surefire-reports",
        "{projectRoot}/target/jacoco-report"
      ],
      "options": {
        "forwardAllArgs": false,
        "command": "./mvnw clean test -pl apps/posts-api -am -Dtest='*E2ETest' -Dsurefire.failIfNoSpecifiedTests=false"
      },
      "dependsOn": ["^publish-local", "docker:build"]
    },
    "publish-local": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^publish-local"],
      "inputs": ["default", "^default"],
      "outputs": [],
      "options": {
        "forwardAllArgs": false,
        "command": "./mvnw install -DskipTests -q -pl apps/posts-api"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "continuous": true,
      "options": {
        "command": "./mvnw quarkus:dev -pl apps/posts-api -Ddebug=5005"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["javaSources"],
      "options": {
        "parallel": false,
        "forwardAllArgs": false,
        "commands": [
          {
            "command": "./mvnw -q -fae spotless:check"
          }
        ]
      },
      "configurations": {
        "fix": {
          "commands": [
            {
              "command": "./mvnw -q -fae spotless:apply"
            }
          ]
        }
      }
    },
    "lambda-http": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["quarkusLambda"],
      "outputs": ["{workspaceRoot}/infra/dist/posts-api-http.zip"],
      "defaultConfiguration": "native",
      "options": {
        "parallel": false,
        "forwardAllArgs": false,
        "mvnFlags": "",
        "extraFlags": "",
        "commands": [
          {
            "command": "mkdir -p infra/dist"
          },
          {
            "command": "./mvnw package -DskipTests -Plambda-http {args.mvnFlags} {args.extraFlags}"
          },
          {
            "command": "cp apps/posts-api/target/function.zip infra/dist/posts-api-http.zip"
          },
          {
            "command": "zip -qj infra/dist/posts-api-http.zip infra/lambda/collector.yaml"
          }
        ]
      },
      "configurations": {
        "native": {
          "mvnFlags": "-Dnative -Pnative-clt-toolchain"
        },
        "native-container": {
          "mvnFlags": "-Dnative -Pnative-container"
        },
        "jvm": {
          "mvnFlags": ""
        }
      }
    },
    "lambda-sqs": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["quarkusLambda"],
      "outputs": ["{workspaceRoot}/infra/dist/posts-api-sqs.zip"],
      "defaultConfiguration": "native",
      "options": {
        "parallel": false,
        "forwardAllArgs": false,
        "mvnFlags": "",
        "extraFlags": "",
        "commands": [
          {
            "command": "mkdir -p infra/dist"
          },
          {
            "command": "./mvnw package -DskipTests -Plambda-sqs {args.mvnFlags} {args.extraFlags}"
          },
          {
            "command": "cp apps/posts-api/target/function.zip infra/dist/posts-api-sqs.zip"
          },
          {
            "command": "zip -qj infra/dist/posts-api-sqs.zip infra/lambda/collector.yaml"
          }
        ]
      },
      "configurations": {
        "native": {
          "mvnFlags": "-Dnative -Pnative-clt-toolchain"
        },
        "native-container": {
          "mvnFlags": "-Dnative -Pnative-container"
        },
        "jvm": {
          "mvnFlags": ""
        }
      }
    },
    "lambda-stream": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["quarkusLambda"],
      "outputs": ["{workspaceRoot}/infra/dist/posts-api-stream.zip"],
      "defaultConfiguration": "native",
      "options": {
        "parallel": false,
        "forwardAllArgs": false,
        "mvnFlags": "",
        "extraFlags": "",
        "prepare": "true",
        "payload": "quarkus-app",
        "commands": [
          {
            "command": "mkdir -p infra/dist"
          },
          {
            "command": "./mvnw package -DskipTests -Plambda-stream {args.mvnFlags} {args.extraFlags}"
          },
          {
            "command": "install -m 755 apps/posts-api/src/main/lambda/run.sh apps/posts-api/target/run.sh"
          },
          {
            "command": "{args.prepare}"
          },
          {
            "command": "rm -f infra/dist/posts-api-stream.zip"
          },
          {
            "command": "cd apps/posts-api/target && zip -qrX ../../../infra/dist/posts-api-stream.zip run.sh {args.payload}"
          },
          {
            "command": "zip -qj infra/dist/posts-api-stream.zip infra/lambda/collector.yaml"
          }
        ]
      },
      "configurations": {
        "native": {
          "mvnFlags": "-Dnative -Pnative-clt-toolchain",
          "prepare": "install -m 755 $(ls apps/posts-api/target/*-runner | head -1) apps/posts-api/target/application",
          "payload": "application"
        },
        "native-container": {
          "mvnFlags": "-Dnative -Pnative-container",
          "prepare": "install -m 755 $(ls apps/posts-api/target/*-runner | head -1) apps/posts-api/target/application",
          "payload": "application"
        },
        "jvm": {
          "mvnFlags": "",
          "prepare": "true",
          "payload": "quarkus-app"
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["quarkusStack"],
      "outputs": ["{projectRoot}/target/quarkus-app"],
      "options": {
        "forwardAllArgs": false,
        "cwd": "apps/posts-api",
        "command": "test -d target/quarkus-app || (cd ../.. && ./mvnw package -DskipTests)"
      }
    },
    "docker:build": {
      "options": {
        "args": ["--tag axonposts/posts-api:e2e"]
      }
    }
  }
}
