{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "implicitDependencies": [
    "web",
    "dev.manuelantunes:quarkus-axon-graphql-posts",
    "dev.manuelantunes:axonposts-tagging"
  ],
  "targets": {
    "lint": {
      "options": {
        "forwardAllArgs": false
      },
      "configurations": {
        "fix": {
          "command": "eslint . --fix"
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "cwd": "apps/web-e2e",
        "command": "tsc --noEmit"
      }
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": [
            "dev.manuelantunes:quarkus-axon-graphql-posts",
            "dev.manuelantunes:axonposts-tagging"
          ],
          "target": "docker:build"
        }
      ],
      "outputs": [
        "{projectRoot}/target/test-results",
        "{projectRoot}/target/playwright",
        "{projectRoot}/target/playwright-report",
        "{projectRoot}/target/logs"
      ],
      "options": {
        "cwd": "apps/web-e2e",
        "forwardAllArgs": false,
        "command": "playwright test"
      }
    }
  }
}
