# O endpoint do subgraph. É lido pelo NAVEGADOR (Apollo e graphql-sse falam direto com o API
# Gateway), então precisa do prefixo NEXT_PUBLIC_ — que faz o Next inlinar o valor no bundle em
# BUILD TIME. Trocar de ambiente é rebuildar, não reiniciar.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8080/graphql

# O emissor, só para a interface mostrar contra quem ela está autenticando.
NEXT_PUBLIC_COGNITO_ISSUER=

# =============================================================================================
# Daqui para baixo é SERVIDOR. Sem NEXT_PUBLIC_, e é de propósito: quem fala com o Cognito são as
# server actions de src/app/actions/auth.ts, e o navegador nunca vê estes valores.
# =============================================================================================
COGNITO_REGION=us-east-1
COGNITO_CLIENT_ID=
