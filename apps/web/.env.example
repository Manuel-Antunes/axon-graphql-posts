NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8080/graphql

NEXT_PUBLIC_COGNITO_ISSUER=

COGNITO_REGION=us-east-1
COGNITO_CLIENT_ID=

# Set OIDC_ISSUER_URL and the provider stops being Cognito. This is the Dev Services / compose
# Keycloak, and it is what `apps/web-e2e` uses.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=axon-posts-api
OIDC_CLIENT_SECRET=
