<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.manuelantunes</groupId>
        <artifactId>quarkus-axon-graphql</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>axon-native-support-deployment</artifactId>
    <name>axon-native-support (deployment)</name>
    <description>Os @BuildStep que geram o metadado de native para o Axon 5</description>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-core-deployment</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>axon-native-support</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
          O TESTE DESTA EXTENSÃO — e ele precisa do Axon só para os FIXTURES.

          O processor não depende do Axon em tempo de compilação: ele trabalha sobre o índice Jandex e
          nomeia as anotações por `DotName`, como string. Mas um teste honesto precisa de classes
          ANOTADAS DE VERDADE para indexar — senão ele estaria afirmando sobre um índice que ele mesmo
          inventou, e não sobre o que o Quarkus entrega.
        -->
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-eventsourcing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- combine.children: soma com o error_prone_core do pom raiz em vez de substituí-lo.
                             Sem isto, `plug-in not found: ErrorProne` — o argumento vem por herança e o jar não. -->
                    <annotationProcessorPaths combine.children="append">
                        <!-- É este processador que gera o META-INF/quarkus-build-steps.list. Sem ele
                             o jar sai com as classes e o Quarkus não descobre um único @BuildStep. -->
                        <path>
                            <groupId>io.quarkus</groupId>
                            <artifactId>quarkus-extension-processor</artifactId>
                            <version>${quarkus.platform.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
