<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.manuelantunes</groupId>
        <artifactId>quarkus-axon-graphql-posts-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>

    <artifactId>axon-native-support</artifactId>
    <name>axon-native-support (runtime)</name>
    <description>Suporte a GraalVM native para o Axon Framework 5 sob a extensão de Quarkus</description>

    <!--
      Este módulo é quase vazio de propósito, e não é desperdício: uma extensão de Quarkus tem SEMPRE
      dois artefatos. O de runtime é o que a aplicação declara como dependência, e o único papel dele
      aqui é carregar o `META-INF/quarkus-extension.properties` com `deployment-artifact=` — é essa
      linha que faz o augmentation ir buscar o módulo de deployment e, com ele, os `@BuildStep`.

      Nada de código de runtime existe porque não há nada a fazer em runtime: tudo que este suporte faz
      acontece em BUILD TIME, registrando reflexão e provedores de serviço.
    -->
    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Gera o META-INF/quarkus-extension.properties com o ponteiro para o deployment. -->
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-extension-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <executions>
                    <execution>
                        <phase>compile</phase>
                        <goals>
                            <goal>extension-descriptor</goal>
                        </goals>
                        <configuration>
                            <deployment>${project.groupId}:axon-native-support-deployment:${project.version}</deployment>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
