<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.manuelantunes</groupId>
        <artifactId>quarkus-axon-graphql</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>axonposts-platform</artifactId>
    <name>platform</name>
    <description>O que é comum a todos os agregados: a porta de eventos de domínio, exclusão lógica e a fiação do Axon</description>

    <!--
      A BASE DO MONÓLITO MODULAR
      ==========================
      Não é um pacote "util": o que está aqui é o que TODO agregado precisa e nenhum agregado possui.
      `DomainEventPublisher` é a porta pela qual as entidades disparam eventos; `SoftDeletable` e
      `SoftDeletion` são o mecanismo de exclusão lógica que três agregados usam; `EventSourcedEntities`
      e `ApplicationClock` são as duas decisões de fiação do Axon que a extensão não adivinha.

      Nenhuma lib de agregado depende de outra lib de agregado através daqui — esta é folha na árvore
      de dependências, e é o que impede que "compartilhado" vire "todo mundo conhece todo mundo".
    -->
    <dependencies>
        <!-- CDI: ApplicationClock é um producer, EventSourcedEntities é um bean -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!-- @Embeddable de EmbeddableSoftDeletable -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm</artifactId>
        </dependency>
        <!-- EventAppender, MessageType e as anotações que os eventos de domínio usam -->
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-eventsourcing</artifactId>
        </dependency>
        <!-- EventSourcedEntityConfigurer, a porta da extensão que EventSourcedEntities implementa -->
        <dependency>
            <groupId>at.meks.quarkiverse.axonframework-extension</groupId>
            <artifactId>quarkus-axon</artifactId>
            <version>${quarkus-axon.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              O ÍNDICE JANDEX NÃO É OPCIONAL, e é a armadilha central do monólito modular em Quarkus.
              Bean CDI, entidade/embeddable JPA e handler do Axon que vivem num JAR EXTERNO são
              INVISÍVEIS ao ArC, ao Hibernate e à extensão do Axon sem `META-INF/jandex.idx`. Sem ele a
              aplicação COMPILA e os beans simplesmente não existem em runtime — falha silenciosa, do
              mesmo tipo que nos custou a sessão inteira.
              A alternativa é `quarkus.index-dependency.*` no properties da aplicação; o índice no
              próprio módulo é melhor porque a lib passa a ser autossuficiente.
            -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
