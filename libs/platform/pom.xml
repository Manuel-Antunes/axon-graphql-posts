<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.manuelantunes</groupId>
        <artifactId>quarkus-axon-graphql</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>axonposts-platform</artifactId>
    <name>platform</name>
    <description>O que é comum a todos os agregados: a porta de eventos de domínio, exclusão lógica e a fiação do Axon</description>

    <!--
      A BASE DO MONÓLITO MODULAR
      ==========================
      Não é um pacote "util": o que está aqui é o que TODO agregado precisa e nenhum agregado possui.
      `DomainEventPublisher` é a porta pela qual as entidades disparam eventos; `SoftDeletable` e
      `SoftDeletion` são o mecanismo de exclusão lógica que três agregados usam; `EventSourcedEntities`
      e `ApplicationClock` são as duas decisões de fiação do Axon que a extensão não adivinha.

      Nenhuma lib de agregado depende de outra lib de agregado através daqui — esta é folha na árvore
      de dependências, e é o que impede que "compartilhado" vire "todo mundo conhece todo mundo".
    -->
    <dependencies>
        <!-- CDI: ApplicationClock é um producer, EventSourcedEntities é um bean -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!-- @Embeddable de EmbeddableSoftDeletable -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm</artifactId>
        </dependency>
        <!-- EventAppender, MessageType e as anotações que os eventos de domínio usam -->
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-eventsourcing</artifactId>
        </dependency>
        <!-- EventSourcedEntityConfigurer e AxonMetricsConfigurer, as portas da extensão que
             EventSourcedEntities e AxonMetrics implementam -->
        <dependency>
            <groupId>at.meks.quarkiverse.axonframework-extension</groupId>
            <artifactId>quarkus-axon</artifactId>
            <version>${quarkus-axon.version}</version>
        </dependency>
        <!-- ==== As métricas do Axon (ver AxonMetrics) =================================== -->
        <!-- Os MessageMonitor do Axon e o MetricsConfigurationEnhancer que os registra. A versão vem do
             axon-framework-bom, que a raiz já importa. -->
        <dependency>
            <groupId>org.axonframework.extensions.metrics</groupId>
            <artifactId>axon-metrics-micrometer</artifactId>
        </dependency>
        <!-- O MeterRegistro de Micrometer que escreve na API do OpenTelemetry. É um JAR, não uma
             extensão — e é justamente isso que permite pôr as métricas AQUI: o `quarkus-micrometer`
             depende de `quarkus-vertx-http`, e a plataforma é importada por um serviço que não tem nem
             quer porta HTTP. Versão do quarkus-bom. -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-micrometer-1.5</artifactId>
        </dependency>
        <!-- SEGUNDA dependência que existe POR CAUSA DO BINÁRIO NATIVO — e o irmão da de baixo.

             `org.axonframework.messaging.core.annotation.MessageStreamResolverUtils` referencia
             `reactor.core.publisher.Mono`, e o Axon declara o Project Reactor OPCIONAL: ele só é usado
             por quem devolve `Mono`/`Flux` de um handler, o que este projeto não faz.

             O `apps/posts-api` tinha reactor-core 3.7.10 por transitividade e nunca soube disso. O
             `apps/tagging` não tem — e foi exatamente ele que quebrou, em `[2/8] Performing analysis`:

               Discovered unresolved type during parsing: reactor.core.publisher.Mono
               ... because class ...MessageStreamResolverUtils is registered for linking at image build time

             Declarar aqui é o que garante que os DOIS apps tenham o mesmo classpath do Axon. A versão
             é a que o posts-api já resolvia; o `axon-framework-bom` não gerencia este artefato. -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <version>3.7.10</version>
        </dependency>
        <!-- ATENÇÃO: esta dependência existe POR CAUSA DO BINÁRIO NATIVO, e por nada mais.

             `io.micrometer.core.instrument.AbstractTimer` referencia `org.LatencyUtils.PauseDetector`
             e `IntervalEstimator` — e o Micrometer as declara OPCIONAIS, porque só são usadas por
             histograma de percentil com detector de pausa. Na JVM elas nunca são carregadas e ninguém
             percebe a ausência.

             O native-image linka em build time e cobra: com o `AbstractTimer` alcançável, o build
             morre em `[2/8] Performing analysis` com

               Discovered unresolved type during parsing: org.LatencyUtils.IntervalEstimator
               Error encountered while parsing io.micrometer.core.instrument.AbstractTimer.record

             Quem normalmente a traz é o `quarkus-micrometer`, que este projeto NÃO usa de propósito
             (ver o comentário do opentelemetry-micrometer acima: ele arrastaria `quarkus-vertx-http`
             para um serviço que não quer porta HTTP). Então ela é declarada aqui, à mão, ao lado do
             Micrometer que a exige. -->
        <dependency>
            <groupId>org.latencyutils</groupId>
            <artifactId>LatencyUtils</artifactId>
            <version>2.0.3</version>
        </dependency>
        <!-- O bean `OpenTelemetry` que AxonMetrics recebe. `provided` porque quem o PRODUZ é a extensão
             na aplicação: a plataforma só o consome, e declarar compile o arrastaria para o runner sem
             necessidade. Toda aplicação deste repositório tem OpenTelemetry — é regra, não coincidência. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-opentelemetry</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              O ÍNDICE JANDEX NÃO É OPCIONAL, e é a armadilha central do monólito modular em Quarkus.
              Bean CDI, entidade/embeddable JPA e handler do Axon que vivem num JAR EXTERNO são
              INVISÍVEIS ao ArC, ao Hibernate e à extensão do Axon sem `META-INF/jandex.idx`. Sem ele a
              aplicação COMPILA e os beans simplesmente não existem em runtime — falha silenciosa, do
              mesmo tipo que nos custou a sessão inteira.
              A alternativa é `quarkus.index-dependency.*` no properties da aplicação; o índice no
              próprio módulo é melhor porque a lib passa a ser autossuficiente.
            -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
