<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.manuelantunes</groupId>
        <artifactId>quarkus-axon-graphql</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>axonposts-users</artifactId>
    <name>users</name>
    <description>O agregado User: domínio, aplicação, identidade e persistência</description>

    <!--
      MÓDULO DO AGREGADO USER
      =======================
      Fatia vertical: o domínio (User polimórfico com Reader/Author, Account, exclusão lógica), a
      aplicação (commands, queries, provisionamento just-in-time) e a infraestrutura dele (o adapter
      Panache e o CurrentUser que lê o SecurityIdentity).

      É o módulo BASE entre os agregados: `posts` depende dele porque `Post.author` é um `User`, e a
      recíproca não existe — `user` não referencia post nem tag em nenhum arquivo. Essa assimetria é o
      que permite a ordem platform → users → posts sem ciclo.
    -->
    <dependencies>
        <dependency>
            <groupId>dev.manuelantunes</groupId>
            <artifactId>axonposts-platform</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm</artifactId>
        </dependency>

        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-eventsourcing</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Sem o índice, bean CDI e entidade JPA desta lib são invisíveis. Ver libs/platform. -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- MapStruct: o `defaultComponentModel=jakarta-cdi` vem do parent e vale aqui também -->
        </plugins>
    </build>
</project>
