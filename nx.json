{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/pom.xml"],
    "production": [
      "default",
      "!{projectRoot}/src/test/**/*",
      "!{projectRoot}/**/*.md"
    ],
    "quarkusLambda": [
      "production",
      "{workspaceRoot}/mvnw",
      "{workspaceRoot}/.mvn/**/*",
      "{workspaceRoot}/libs/**/pom.xml",
      "{workspaceRoot}/libs/**/src/main/**/*",
      "{workspaceRoot}/infra/lambda/collector.yaml",
      "{workspaceRoot}/infra/scripts/build-env.sh"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/maven"
    }
  ],
  "analytics": false
}
