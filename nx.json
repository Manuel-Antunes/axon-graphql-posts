{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/pom.xml"],
    "production": [
      "default",
      "!{projectRoot}/src/test/**/*",
      "!{projectRoot}/**/*.md"
    ]
  },
  "plugins": [
    {
      "plugin": "@nx/maven"
    }
  ],
  "analytics": false
}
