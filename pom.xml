<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>dev.manuelantunes</groupId>
    <artifactId>axon-graphql-posts</artifactId>
    <version>0.2.0-SNAPSHOT</version>
    <name>axon-graphql-posts</name>
    <description>POC: Axon Framework 5 (entidades anotadas, DCB) + Reactor extension + GraphQL subscriptions over SSE</description>

    <properties>
        <java.version>21</java.version>
        <!-- Axon Framework 5.3.x: entidades anotadas (@EventSourced/@EntityCreator), command handlers como
             classes (@InjectEntity), reactor extension (Mono/Flux gateways) no mesmo repositório. -->
        <axon.version>5.3.1</axon.version>
        <!-- MapStruct: mapeamento input GraphQL -> command, gerado em tempo de compilação
             (código-fonte legível em target/generated-sources, zero reflexão em runtime). -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <!-- Módulo Testcontainers do Keycloak; não está no BOM do Boot -->
        <testcontainers-keycloak.version>3.7.0</testcontainers-keycloak.version>
        <!-- JaCoCo: cobertura dos testes. O parent do Boot não gerencia a versão deste plugin -->
        <jacoco.version>0.8.13</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.axonframework</groupId>
                <artifactId>axon-framework-bom</artifactId>
                <version>${axon.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web: WebFlux + Spring for GraphQL (HTTP, SSE e WebSocket no mesmo /graphql) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-graphql</artifactId>
        </dependency>

        <!-- DevTools: reinício automático quando as classes mudam, e LiveReload.
             `optional` para não vazar para quem depender deste artefato; o spring-boot-maven-plugin já o
             exclui do jar executável, então isto é ferramenta de desenvolvimento e nada mais.

             ATENÇÃO ao que um reinício significa aqui: o event store é em memória (AxonConfig), então
             cada restart apaga os eventos enquanto as LINHAS continuam no Postgres. Um post criado antes
             do restart continua aparecendo em `post(id:)` e some do `updatePost`, que reidrata o agregado
             do stream — EntityNotFoundException, NOT_FOUND. Não é bug do DevTools; é a POC. Para uma
             sessão longa de edição, ou se recria os dados depois de cada restart, ou se troca o
             InMemoryEventStorageEngine pelo event store JPA. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Bean Validation (Hibernate Validator): valida os inputs do GraphQL na borda.
             O AnnotatedControllerConfigurer do Spring GraphQL liga a validação sozinho quando
             encontra um bean jakarta.validation.Validator no contexto. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MapStruct: só as anotações; o processor fica no annotationProcessorPaths abaixo -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- Read model: Spring Data JPA sobre PostgreSQL.
             Saiu o SQLite (e com ele o hibernate-community-dialects, que só existia para o dialeto dele):
             o Keycloak precisa de um banco de verdade, e rodar os dois no mesmo Postgres do compose é o
             que torna o ambiente reproduzível. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway: o schema passa a ser versionado em SQL, e o ddl-auto vira `validate`.
             O flyway-database-postgresql é obrigatório desde o Flyway 10: o suporte a cada banco saiu
             do core para módulos próprios. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Segurança: WebFlux reativo + resource server JWT.
             O resource-server traz o nimbus-jose-jwt, que é o que assina e valida o token HS256;
             o starter-security traz o BCryptPasswordEncoder e o @EnableReactiveMethodSecurity. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Axon Framework 5: starter Spring Boot (messaging + modelling + eventsourcing + autoconfigure) -->
        <dependency>
            <groupId>org.axonframework.extensions.spring</groupId>
            <artifactId>axon-spring-boot-starter</artifactId>
        </dependency>
        <!-- Reactor extension: ReactorCommandGateway / ReactorQueryGateway (Mono/Flux).
             Não está no BOM, por isso a versão explícita. -->
        <dependency>
            <groupId>org.axonframework.extensions.reactor</groupId>
            <artifactId>axon-reactor</artifactId>
            <version>${axon.version}</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: os testes sobem Postgres e Keycloak de verdade.
             O spring-boot-testcontainers dá o @ServiceConnection, que dispensa escrever
             @DynamicPropertySource para o datasource. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Módulo comunitário do Keycloak: sobe o container já com o realm importado -->
        <dependency>
            <groupId>com.github.dasniko</groupId>
            <artifactId>testcontainers-keycloak</artifactId>
            <version>${testcontainers-keycloak.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.graphql</groupId>
            <artifactId>spring-graphql-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- O realm do Keycloak entra no classpath de teste a partir de docker/, e não de uma cópia:
                 o container dos testes importa exatamente o mesmo arquivo que o docker compose monta.
                 Duas cópias divergiriam, e a divergência só apareceria quando um deles quebrasse. -->
            <testResource>
                <directory>docker/keycloak</directory>
                <includes>
                    <include>realm-*.json</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- -parameters (herdado do parent do Boot) é o que permite ao Spring GraphQL
                         casar @Argument com o nome do parâmetro. -->
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
                <executions>
                    <execution>
                        <!-- Só no compile das fontes principais: os testes não têm mapper, e passar as
                             opções lá só rende um "options were not recognized by any processor". -->
                        <id>default-compile</id>
                        <configuration>
                            <compilerArgs>
                                <!-- Propriedade do destino sem origem = erro de compilação, não aviso.
                                     É o que faz um campo novo no command quebrar o build em vez de
                                     chegar null do outro lado. -->
                                <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- JaCoCo: o agente entra no surefire por prepare-agent e o relatório sai em
                 target/site/jacoco (HTML, XML e CSV) ao fim da fase test. Nenhum `check` com mínimo por
                 enquanto: cobertura aqui é instrumento de leitura, não portão de build. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
